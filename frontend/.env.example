# Copy to frontend/.env.local. Base URL of the FastAPI backend (no trailing slash).
# Requests to /api/* are proxied there by next.config.ts.
BACKEND_URL=http://localhost:8000
# Must match the backend's COOKIE_NAME (read by src/proxy.ts).
SESSION_COOKIE_NAME=r53_session
# Shown read-only on the sign-in page; matches the seeded demo account.
NEXT_PUBLIC_DEMO_ACCOUNT_ID=123456789012
