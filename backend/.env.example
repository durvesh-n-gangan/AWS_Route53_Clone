# Copy to backend/.env and adjust. Every value has a safe local default.
# SQLite file used by the API and Alembic.
DATABASE_URL=sqlite:///./data/route53.db
# Comma-separated list of browser origins allowed by CORS.
FRONTEND_ORIGIN=http://localhost:3000
# How long a login session lasts.
SESSION_TTL_HOURS=12
# Name of the session cookie.
COOKIE_NAME=r53_session
# Keep false for local http://localhost. Set to true for any HTTPS deployment, otherwise
# browsers send the session cookie over plain HTTP too.
COOKIE_SECURE=false
# Seed the demo user and sample zones on startup when the database is empty.
SEED_ON_START=false
# Failed sign-ins allowed per IP + username within the window before returning 429.
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=300
